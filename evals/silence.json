{
  "name": "reads and searches are never news",
  "why": "The single most important behaviour. An agent that narrates every file read is worse than silence, and this is the case that proves it stays quiet.",
  "mode": "verbose",
  "hooks": [
    {"hook_event_name": "PreToolUse", "tool_name": "Grep", "tool_input": {"pattern": "refreshToken"}},
    {"hook_event_name": "PreToolUse", "tool_name": "Read", "tool_input": {"file_path": "src/auth/token.ts"}},
    {"hook_event_name": "PreToolUse", "tool_name": "Glob", "tool_input": {"pattern": "**/*.ts"}},
    {"hook_event_name": "PostToolUse", "tool_name": "Read", "tool_input": {"file_path": "src/auth/token.ts"}, "tool_response": "export const x = 1"}
  ],
  "expect": {"spoken": 0}
}
